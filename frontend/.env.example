# Copy this template to .env.local, then enter your own values.
# Commit this template only. Never commit .env.local or .local-data/.

# Required for Supabase login, consent records and account-scoped behavior data.
# Use the project root URL, without /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PO9k4kiqbd4BE83CK7aFEg_dmcPYLLS
APP_URL=http://127.0.0.1:3080

# Account deletion only: server-only secret. Prefer SUPABASE_SECRET_KEY.
# The legacy service_role key is supported as an alternative, not an extra requirement.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Maps SDK/place search uses the JavaScript key; routing uses the REST key.
# Supabase Kakao OAuth credentials are configured separately in its dashboard.
KAKAO_JAVASCRIPT_KEY=161551786aaf8ae8f85da72b18ece5f6
KAKAO_REST_API_KEY=8c8b4fbb23924b04f82b2d2eef20a6cd

# Public Data Portal Decoding key. Use a shared key or the two per-service keys.
PUBLIC_DATA_SERVICE_KEY=b6c2ec339de7def60d48c5f7a2d1cb7a29f851582f57754f951e08d86c653994
PUBLIC_DATA_HOSPITAL_KEY=
PUBLIC_DATA_PHARMACY_KEY=

# Optional: only used when manually regenerating stored UI translations.
# Not required for the app's existing five-language UI. No Gemini demo remains.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Legacy direct-Kakao/SQLite implementation only; unused by current Supabase OAuth.
# Retained here to document existing local variables. Do not use for new integration.
KAKAO_CLIENT_SECRET=uEeJamryuMCQ4V3zsJY1tJhszvywdYJz
KAKAO_REDIRECT_URI=http://127.0.0.1:3080/api/auth/kakao/callback


# Legacy test server port. Next.js uses the --port CLI option in package.json.
# PORT=3080
# NODE_ENV is managed by Next.js; do not set it in .env.local.

# Local Korean STT/TTS (see ../voice_service/README.md)
NEXT_PUBLIC_VOICE_ENABLED=0

# Optional local voice server port (default 3091).
# VOICE_SERVICE_PORT=3091

# Hosted transcription: Vercel Preview only. Do not enable this in Production.
# NEXT_PUBLIC_VOICE_EXTERNAL_STT=1
# VOICE_STT_PROVIDER=openai
# VOICE_OPENAI_API_KEY=
# VOICE_CONSENT_SECRET=

# When hosting the care engine, configure it in the frontend server environment.
# Local next dev can instead read the allowed LLM settings from care_engine/.env.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=
