# Kakao Maps JavaScript key (not REST API or Admin key).
KAKAO_JAVASCRIPT_KEY=

# Optional: keep a fixed port and register that exact URL in Kakao.
# PORT=3081

# Public Data Portal general (Decoding) key, approved for both NMC services.
PUBLIC_DATA_SERVICE_KEY=
# If the two services have different keys, use these instead:
# PUBLIC_DATA_HOSPITAL_KEY=
# PUBLIC_DATA_PHARMACY_KEY=

# Kakao REST API key, kept on the server for walking/transit/driving routes.
KAKAO_REST_API_KEY=
