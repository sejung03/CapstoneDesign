# Local care engine only. Use real keys in .env (ignored by Git).
# mock runs without an API key; use openai to enable the deployed provider.
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Optional; if blank, the engine uses the configured provider's default.
LLM_MODEL=
# Optional diagnostics and tuning. Leave unset to use code defaults.
# LLM_REASONING_EFFORT=
# LLM_TEMPERATURE=
# LLM_CANDIDATE_MODE=
# LLM_CANDIDATE_K=
# LLM_TIMEOUT_MS=
# LLM_BUDGET_MS=
# The browser's own consent gate is never bypassed by this setting.
LLM_DEV_CONSENT=
LLM_SERVICE_TIER=
